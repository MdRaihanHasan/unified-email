APP_NAME="Unified Email"
APP_ENV=local
# php artisan key:generate
#
# Every connected account's refresh token and app password is encrypted with this
# key. Lose it and all three accounts have to be reconnected from scratch — back
# it up somewhere other than this machine.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres, not SQLite: the messages table uses a generated tsvector column and a
# GIN index for search, plus jsonb throughout.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=unified_email
DB_USERNAME=unified
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel's own outgoing mail (password resets etc). Mail sent *from* the inbox
# does not go through this — it goes out through each account's own provider.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Google — both personal Gmail and Workspace, through one OAuth client
# ---------------------------------------------------------------------------
# Set the consent screen's publishing status to "In production". That is what
# stops refresh tokens being revoked after 7 days (a Testing-status rule) and
# what lets an unverified app keep using restricted scopes — at the cost of a
# one-time warning screen per account. See docs/provider-setup.md.
#
# The redirect URI must match the one registered in Google Cloud Console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/gmail/callback"

# ---------------------------------------------------------------------------
# Outlook.com — Microsoft Graph
# ---------------------------------------------------------------------------
# "common" covers personal Outlook.com and work accounts alike. No publisher
# verification is needed for a single self-consenting user.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_URI="${APP_URL}/oauth/microsoft/callback"

# Personal @gmail.com uses an app password over IMAP/SMTP and is configured
# per-account in the UI, not here — the credentials are stored encrypted in the
# database rather than in this file.

# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------
SYNC_BACKFILL_DAYS=90
SYNC_BACKFILL_PAGE_SIZE=100
SYNC_STALE_AFTER_MINUTES=15
SYNC_IDLE_REFRESH_MINUTES=25
SYNC_THREAD_WINDOW_DAYS=30

# Account (id or email) the imap-idle container idles on:
#   docker compose --profile idle up -d
IDLE_ACCOUNT=

VITE_APP_NAME="${APP_NAME}"
